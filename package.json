{
  "name": "sd-webui-pnginfo-beautify",
  "version": "1.0.0",
  "description": "",
  "keywords": [
    "create-by-yarn-tool"
  ],
  "license": "ISC",
  "author": "bluelovers",
  "sideEffects": false,
  "main": "index.js",
  "scripts": {
    "install:frozenLockfile": "yarn-tool install --frozen-lockfile",
    "install:resetLockfile": "yarn-tool install --reset-lockfile",
    "build": "tsx ./build.ts",
    "test": "echo test",
    "ci:install": "pnpm install --frozen-lockfile && pnpm add yarn-tool lerna@10 ynpx ts-node ts-jest jest typescript@next @bluelovers/jest-config tsx",
    "ci:build": "pnpm run build && pnpm run ci:build:commit && pnpm run postpublish:changelog && pnpm run postpublish:git:commit && pnpm run postpublish:git:push",
    "ci:build:commit": "git add ./output && git commit ./output -m \"build: update build\" & echo ci:build:commit",
    "npm:publish": "echo fake npm publish",
    "npm:publish:bump": "pnpm run version:bump && pnpm run npm:publish",
    "npm:publish:bump:major": "pnpm run version:bump:major && pnpm run npm:publish",
    "npm:publish:bump:minor": "pnpm run version:bump:minor && pnpm run npm:publish",
    "npm:publish:bump:patch": "pnpm run version:bump:patch && pnpm run npm:publish",
    "npm:publish:bump:prerelease": "pnpm run version:bump:prerelease && pnpm run npm:publish",
    "ws:fix-all": "yarn-tool fix-all  --overwriteHostedGitInfo",
    "ws:fix-all:resetStaticFiles": "pnpm run ws:fix-all -- --resetStaticFiles",
    "preversion": "echo preversion && pnpm run test",
    "version": "echo version",
    "version:bump": "yarn-tool version",
    "version:bump:major": "pnpm run version:bump -- --bump major",
    "version:bump:minor": "pnpm run version:bump -- --bump minor",
    "version:bump:patch": "pnpm run version:bump -- --bump patch",
    "version:bump:prerelease": "pnpm run version:bump -- --bump prerelease",
    "postversion": "echo postversion",
    "prepublish": "echo prepublish",
    "prepare": "echo prepare",
    "prepublishOnly": "pnpm run preversion",
    "publish": "echo publish",
    "postpublish": "pnpm run postpublish:changelog && pnpm run postpublish:git:commit && pnpm run postpublish:git:tag && pnpm run postpublish:git:push",
    "postpublish:changelog": "ynpx --quiet @yarn-tool/changelog && git add ./CHANGELOG.md",
    "postpublish:git:commit": "git commit -m \"chore(release): publish\" . & echo postpublish:git:commit",
    "postpublish:git:push": "git push --follow-tags",
    "postpublish:git:tag": "ynpx --quiet @yarn-tool/tag",
    "postpublishOnly": "echo postpublishOnly",
    "ncu": "yarn-tool ncu -u",
    "sort-package-json": "yarn-tool sort",
    "tsc:default": "tsc -p tsconfig.json",
    "tsc:esm": "tsc -p tsconfig.esm.json",
    "tsc:showConfig": "ynpx get-current-tsconfig -p"
  },
  "dependencies": {
    "@bluelovers/auto1111-pnginfo": "^2.0.6",
    "@bluelovers/jest-config": "^1.1.11",
    "@shikijs/core": "^4.4.3",
    "jest": "^30.4.2",
    "lerna": "^10.0.1",
    "shiki": "^4.4.3",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "7.1.0-dev.20260821.1",
    "yarn-tool": "^3.0.6",
    "ynpx": "^3.0.4"
  },
  "devDependencies": {
    "@bluelovers/tsconfig": "^2.0.3",
    "@types/bluebird": "^3.5.42",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.2.0",
    "bluebird": "^3.7.2",
    "esbuild": "^0.28.2",
    "esbuild-sass-plugin": "^3.7.0",
    "fs-extra": "^11.4.0",
    "stable-diffusion-webui-types": "^1.0.3",
    "tslib": "^2.8.1",
    "upath2": "^3.1.25"
  }
}
